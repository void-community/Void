#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -lt 1 ]]; then
  echo "Usage: $0 <portablemc-version> [portablemc-start-argument ...]" >&2
  exit 1
fi

portablemc_version="$1"
shift
# The retries span more than 3 minutes, as a CDN in front of a library repository can keep serving a 404 its origin returned once for
# that long.
attempts="${PORTABLEMC_DRY_RUN_ATTEMPTS:-6}"
retry_delay_seconds="${PORTABLEMC_DRY_RUN_RETRY_DELAY_SECONDS:-12}"
# A repository's CDN sometimes serves one connection at a few kilobytes per second, which a new attempt gets past, as it connects again.
minimum_download_speed="${PORTABLEMC_DRY_RUN_MINIMUM_DOWNLOAD_SPEED:-131072}"
download_speed_window_seconds=30

if [[ ! "$attempts" =~ ^[1-9][0-9]*$ ]]; then
  echo "PORTABLEMC_DRY_RUN_ATTEMPTS must be a positive integer." >&2
  exit 1
fi

if [[ ! "$retry_delay_seconds" =~ ^[0-9]+$ ]]; then
  echo "PORTABLEMC_DRY_RUN_RETRY_DELAY_SECONDS must be a non-negative integer." >&2
  exit 1
fi

if [[ ! "$minimum_download_speed" =~ ^[0-9]+$ ]]; then
  echo "PORTABLEMC_DRY_RUN_MINIMUM_DOWNLOAD_SPEED must be a non-negative integer." >&2
  exit 1
fi

# Passes portablemc's output through, and fails once a download, which machine output reports as "download", done/count, bytes/total and
# its seconds so far, received less than the minimum speed over the window. It reads each line as it comes, which awk doesn't from a pipe.
watch_downloads() {
  local line rest bytes elapsed watching=false since_bytes=0 since_elapsed=0

  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line"

    if [[ "$line" != download$'\t'* ]]; then
      watching=false
      continue
    fi

    rest="${line#*$'\t'*$'\t'}"
    bytes="${rest%%/*}"
    rest="${rest#*$'\t'}"
    elapsed="${rest%%[.$'\t']*}"

    [[ "$bytes" =~ ^[0-9]+$ && "$elapsed" =~ ^[0-9]+$ ]] || continue

    if [[ "$watching" == false ]] || ((elapsed < since_elapsed || bytes < since_bytes)); then
      watching=true
      since_bytes="$bytes"
      since_elapsed="$elapsed"
    elif ((elapsed - since_elapsed >= download_speed_window_seconds)); then
      if ((bytes - since_bytes < minimum_download_speed * (elapsed - since_elapsed))); then
        echo "portablemc downloaded $((bytes - since_bytes)) bytes in $((elapsed - since_elapsed)) seconds, slower than $minimum_download_speed bytes per second." >&2
        return 75
      fi

      since_bytes="$bytes"
      since_elapsed="$elapsed"
    fi
  done
}

# Runs portablemc and stops it when a download is too slow. It ignores a closed output, so it is stopped by its process.
run_portablemc() {
  if ((minimum_download_speed == 0)); then
    portablemc "${portablemc_start_arguments[@]}"
    return
  fi

  local output watch_exit_code=0
  output="$(mktemp -u)"
  mkfifo "$output"
  portablemc "${portablemc_start_arguments[@]}" > "$output" &
  local portablemc_pid=$!

  watch_downloads < "$output" || watch_exit_code=$?
  rm -f "$output"

  if ((watch_exit_code != 0)); then
    kill "$portablemc_pid" 2> /dev/null || true
    wait "$portablemc_pid" 2> /dev/null || true
    return "$watch_exit_code"
  fi

  wait "$portablemc_pid"
}

last_exit_code=0
portablemc_start_arguments=(start --dry "$portablemc_version" "$@")
platform_arguments_provided=false
main_directory="$HOME/.minecraft"
previous_argument=""

for argument in "$@"; do
  case "$argument" in
    --fix-lwjgl | --fix-lwjgl=* | --jvm | --jvm=*) platform_arguments_provided=true ;;
    --main-dir=*) main_directory="${argument#--main-dir=}" ;;
  esac

  if [[ "$previous_argument" == "--main-dir" ]]; then
    main_directory="$argument"
  fi

  previous_argument="$argument"
done

# Mirrors the client's ARM64 rule: LWJGL 3.2.3+ follows the version JSON, older LWJGL 3 releases use the 3.3.3 natives,
# and modules without ARM64 natives on Maven Central are excluded.
if [[ "$(uname -m)" == "aarch64" && "$portablemc_version" == mojang:* && "$platform_arguments_provided" == false ]]; then
  minecraft_version="${portablemc_version#mojang:}"
  version_metadata_path="$main_directory/versions/$minecraft_version/$minecraft_version.json"
  version_metadata=""

  if [[ -f "$version_metadata_path" ]]; then
    version_metadata="$(cat "$version_metadata_path")"
  else
    version_metadata_url="$(curl --fail --silent --show-error --location --retry 3 https://piston-meta.mojang.com/mc/game/version_manifest_v2.json \
      | jq -r --arg id "$minecraft_version" 'first(.versions[] | select(.id == $id) | .url) // empty')" || version_metadata_url=""

    if [[ -n "$version_metadata_url" ]]; then
      version_metadata="$(curl --fail --silent --show-error --location --retry 3 "$version_metadata_url")" || version_metadata=""
    fi
  fi

  if [[ -z "$version_metadata" ]]; then
    echo "Minecraft $minecraft_version version metadata is unavailable; ARM64 LWJGL arguments are skipped." >&2
  else
    lwjgl_version="$(jq -r '[.libraries[]?.name | split(":") | select(.[0] == "org.lwjgl") | .[2]] | max_by(split("-")[0] | split(".") | map(tonumber? // 0)) // empty' <<< "$version_metadata")"

    if [[ -n "$lwjgl_version" ]]; then
      fix_version="3.3.3"

      if [[ "$(printf '%s\n' 3.2.3 "${lwjgl_version%%-*}" | sort -V | head -n 1)" == "3.2.3" ]]; then
        fix_version="$lwjgl_version"
      fi

      portablemc_start_arguments+=(--fix-lwjgl "$fix_version")
      mapfile -t lwjgl_modules < <(jq -r '[.libraries[]?.name | split(":") | select(.[0] == "org.lwjgl" and length == 3) | .[1]] | unique[]' <<< "$version_metadata")

      for lwjgl_module in "${lwjgl_modules[@]}"; do
        natives_url="https://repo1.maven.org/maven2/org/lwjgl/$lwjgl_module/$fix_version/$lwjgl_module-$fix_version-natives-linux-arm64.jar"
        natives_status="$(curl --silent --head --location --retry 3 --output /dev/null --write-out '%{http_code}' "$natives_url")" || natives_status="000"

        if [[ "$natives_status" == "404" ]]; then
          portablemc_start_arguments+=(--exclude-lib "org.lwjgl:$lwjgl_module:*:natives-linux-arm64")
        fi
      done
    fi
  fi
fi

for ((attempt = 1; attempt <= attempts; attempt++)); do
  echo "Running portablemc dry-run for $portablemc_version (attempt $attempt/$attempts)."

  if run_portablemc; then
    exit 0
  else
    last_exit_code="$?"
  fi

  if ((attempt == attempts)); then
    break
  fi

  delay_seconds=$((retry_delay_seconds * attempt))
  echo "portablemc dry-run for $portablemc_version failed with exit code $last_exit_code; retrying in ${delay_seconds}s." >&2
  sleep "$delay_seconds"
done

echo "portablemc dry-run for $portablemc_version failed after $attempts attempts (last exit code $last_exit_code)." >&2
exit "$last_exit_code"
